<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">

  <xacro:property name="half_pi" value="${pi / 2.0}" />

  <!-- Base geometry from SDF, meters -->
  <xacro:property name="base_length" value="1.05" />
  <xacro:property name="base_width" value="0.52" />
  <xacro:property name="base_height" value="0.22" />
  <xacro:property name="base_visual_z" value="0.12" />

  <!-- Base mass and inertia from SDF -->
  <xacro:property name="base_mass" value="12.0" />
  <xacro:property name="base_ixx" value="0.55" />
  <xacro:property name="base_iyy" value="1.10" />
  <xacro:property name="base_izz" value="1.40" />

  <!-- Wheel geometry from SDF -->
  <xacro:property name="wheel_radius" value="0.12" />
  <xacro:property name="wheel_width" value="0.07" />
  <xacro:property name="wheel_mass" value="0.8" />
  <xacro:property name="wheel_ixx" value="0.006" />
  <xacro:property name="wheel_iyy" value="0.003" />
  <xacro:property name="wheel_izz" value="0.006" />

  <!-- Ackermann layout from SDF poses -->
  <xacro:property name="wheelbase" value="0.80" />
  <xacro:property name="track" value="0.62" />

  <!-- Front steering knuckles from SDF -->
  <xacro:property name="knuckle_mass" value="0.2" />
  <xacro:property name="knuckle_i" value="0.001" />
  <xacro:property name="steering_limit" value="0.55" />
  <xacro:property name="steering_effort" value="25.0" />
  <xacro:property name="steering_velocity" value="1.0" />

  <!-- Sensor poses from SDF -->
  <xacro:property name="sensor_x" value="0.28" />
  <xacro:property name="sensor_y" value="0.0" />
  <xacro:property name="sensor_z" value="0.38" />

  <!-- Sensor inertias from SDF -->
  <xacro:property name="camera_mass" value="0.033333333333" />
  <xacro:property name="camera_i" value="0.000333333333" />
  <xacro:property name="lidar_mass" value="0.033333333333" />
  <xacro:property name="lidar_i" value="0.000333333333" />
  <xacro:property name="imu_mass" value="0.033333333334" />
  <xacro:property name="imu_i" value="0.000333333334" />

  <xacro:property name="camera_marker_radius" value="0.06" />
  <xacro:property name="lidar_marker_radius"  value="0.06" />
  <xacro:property name="lidar_marker_length"  value="0.08" />
  <xacro:property name="imu_marker_size"      value="0.08" />

  <xacro:macro name="wheel" params="prefix parent ox oy oz">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_dark_gray">
          <color rgba="0.04 0.04 0.04 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}" />
        <inertia
          ixx="${wheel_ixx}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_iyy}"
          iyz="0.0"
          izz="${wheel_izz}"
        />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${prefix}_wheel" />
      <origin xyz="${ox} ${oy} ${oz}" rpy="${half_pi} 0.0 0.0" />
      <axis xyz="0.0 0.0 1.0" />
    </joint>
  </xacro:macro>

  <xacro:macro name="steering_knuckle" params="prefix x y">
    <link name="${prefix}_knuckle">
      <inertial>
        <mass value="${knuckle_mass}" />
        <inertia
          ixx="${knuckle_i}"
          ixy="0.0"
          ixz="0.0"
          iyy="${knuckle_i}"
          iyz="0.0"
          izz="${knuckle_i}"
        />
      </inertial>
    </link>

    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link" />
      <child link="${prefix}_knuckle" />
      <origin xyz="${x} ${y} 0.0" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 0.0 1.0" />
      <limit
        lower="${0.0 - steering_limit}"
        upper="${steering_limit}"
        effort="${steering_effort}"
        velocity="${steering_velocity}"
      />
    </joint>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 ${base_visual_z}" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <material name="base_blue">
        <color rgba="0.05 0.36 0.72 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${base_visual_z}" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>

    <inertial>
      <mass value="${base_mass}" />
      <inertia
        ixx="${base_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_iyy}"
        iyz="0.0"
        izz="${base_izz}"
      />
    </inertial>
  </link>

  <xacro:steering_knuckle
    prefix="front_left"
    x="${wheelbase / 2.0}"
    y="${track / 2.0}"
  />
  <xacro:steering_knuckle
    prefix="front_right"
    x="${wheelbase / 2.0}"
    y="${0.0 - track / 2.0}"
  />

  <xacro:wheel
    prefix="front_left"
    parent="front_left_knuckle"
    ox="0.0"
    oy="0.0"
    oz="0.0"
  />
  <xacro:wheel
    prefix="front_right"
    parent="front_right_knuckle"
    ox="0.0"
    oy="0.0"
    oz="0.0"
  />
  <xacro:wheel
    prefix="rear_left"
    parent="base_link"
    ox="${0.0 - wheelbase / 2.0}"
    oy="${track / 2.0}"
    oz="0.0"
  />
  <xacro:wheel
    prefix="rear_right"
    parent="base_link"
    ox="${0.0 - wheelbase / 2.0}"
    oy="${0.0 - track / 2.0}"
    oz="0.0"
  />

  <link name="camera_link">
    <visual>
      <geometry>
        <sphere radius="${camera_marker_radius}" />
      </geometry>
      <material name="camera_green">
        <color rgba="0.0 0.8 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${camera_marker_radius}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}" />
      <inertia
        ixx="${camera_i}"
        ixy="0.0"
        ixz="0.0"
        iyy="${camera_i}"
        iyz="0.0"
        izz="${camera_i}"
      />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0.0 0.0 0.0" />
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_marker_radius}" length="${lidar_marker_length}" />
      </geometry>
      <material name="lidar_red">
        <color rgba="0.8 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_marker_radius}" length="${lidar_marker_length}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}" />
      <inertia
        ixx="${lidar_i}"
        ixy="0.0"
        ixz="0.0"
        iyy="${lidar_i}"
        iyz="0.0"
        izz="${lidar_i}"
      />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0.0 0.0 0.0" />
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_marker_size} ${imu_marker_size} ${imu_marker_size}" />
      </geometry>
      <material name="imu_orange">
        <color rgba="1.0 0.5 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${imu_marker_size} ${imu_marker_size} ${imu_marker_size}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${imu_mass}" />
      <inertia
        ixx="${imu_i}"
        ixy="0.0"
        ixz="0.0"
        iyy="${imu_i}"
        iyz="0.0"
        izz="${imu_i}"
      />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0.0 0.0 0.0" />
  </joint>

</robot>